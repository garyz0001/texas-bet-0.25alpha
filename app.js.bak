'use strict';
/* =========================================================
   德州扑克 · 虚拟下注器
   —— 只记录筹码与下注；现实发牌、现实看牌、手动确认胜负
   下注语义：所有金额都是「本轮下注总额 (raise-to)」
   支持：主池/边池分配、撤销、多人平分、抓头位、快捷键
   ========================================================= */

const S = {
  players: [],       // {id,name,chips,folded,allIn,street,inHand,acted,lastAct}
  sb: 5, bb: 10,
  buttonSeat: 0,
  straddleSeat: -1,  // 抓头座位，-1 = 无
  handNo: 0,
  pot: 0,            // 已收进底池的筹码（不含本轮 street）
  street: 0,         // 0 翻前 1 翻牌 2 转牌 3 河牌 4 摊牌
  streetBet: 0,
  current: null,
  lastActorSeat: -1,
  log: [],
  history: [],
  phase: 'idle',     // idle | playing | showdown | over
  pots: [],          // 摊牌分配用：[{amount, eligible:[id], winners:[id]}]
};

const STREET_NAME = ['翻牌前', '翻牌', '转牌', '河牌', '摊牌'];
const $ = id => document.getElementById(id);
const fmt = v => Math.round(v).toLocaleString('zh-CN');

/* ---------- 工具 ---------- */
function toast(msg) {
  const t = $('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._tm);
  t._tm = setTimeout(() => t.classList.remove('show'), 2200);
}
function esc(s) {
  return String(s).replace(/[&<>"']/g, c =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}
function logMsg(msg, cls) {
  S.log.push({ msg, cls: cls || '' });
  if (S.log.length > 400) S.log.shift();
  const el = $('log');
  el.innerHTML = S.log.slice(-80).map(l => '<div class="' + l.cls + '">' + esc(l.msg) + '</div>').join('');
  el.scrollTop = el.scrollHeight;
}
const N = () => S.players.length;
const at = seat => S.players[((seat % N()) + N()) % N()];
const seatOf = p => S.players.indexOf(p);
const boardPot = () => S.pot + S.players.reduce((s, p) => s + p.street, 0);

/* ---------- 撤销 ---------- */
function snap() {
  return JSON.stringify({
    players: S.players, buttonSeat: S.buttonSeat, handNo: S.handNo, pot: S.pot,
    street: S.street, streetBet: S.streetBet, current: S.current,
    lastActorSeat: S.lastActorSeat, phase: S.phase,
  });
}
function pushSnap() { S.history.push(snap()); if (S.history.length > 150) S.history.shift(); }
function undo() {
  const s = S.history.pop();
  if (!s) return toast('没有可撤销的操作');
  Object.assign(S, JSON.parse(s));
  $('mShowdown').classList.add('hidden');
  logMsg('↩︎ 已撤销', 'sys');
  render();
}

/* ---------- 开桌 ---------- */
function newGame(cfg) {
  S.sb = cfg.sb; S.bb = cfg.bb;
  S.straddleSeat = (cfg.straddleSeat == null ? -1 : cfg.straddleSeat);
  S.players = [];
  for (let i = 0; i < cfg.count; i++) {
    S.players.push({
      id: i,
      name: (cfg.names[i] || '').trim() || ('玩家 ' + (i + 1)),
      chips: (cfg.stacks && cfg.stacks[i] != null) ? Math.max(0, Math.round(cfg.stacks[i])) : cfg.buyin,
      folded: false, allIn: false,
      street: 0, inHand: 0, acted: false, lastAct: '',
    });
  }
  S.buttonSeat = 0; S.handNo = 0; S.pot = 0; S.street = 0;
  S.log = []; S.history = []; S.pots = [];
  logMsg('━━ 新牌桌：' + cfg.count + ' 人 · 买入 ' + fmt(cfg.buyin) + ' · 盲注 ' + S.sb + '/' + S.bb +
    (S.straddleSeat >= 0 ? ' · 抓头位：' + S.players[S.straddleSeat].name : ''), 'sys');
  S.phase = 'playing';
  nextHand();
}

/* ---------- 位置 ---------- */
const straddleOn = () =>
  S.straddleSeat >= 0 && !!S.players[S.straddleSeat] &&
  S.players[S.straddleSeat].chips > 0 && N() >= 3 &&
  S.straddleSeat !== (S.buttonSeat + 1) % N();   // 不能和小盲同座

/* ---------- 新一手 ---------- */
function nextHand() {
  // 安全网：上一手若未结算（理论上不会发生），先把桌上铎牌退回，避免凭空消失
  const loose = S.pot + S.players.reduce((t, p) => t + p.street, 0);
  if (loose > 0) {
    S.pot = 0;
    S.players.forEach(p => { p.chips += p.street; p.street = 0; });
    logMsg('! 上一手未结算，' + fmt(loose) + ' 铎牌已退回桌上', 'sys');
  }
  S.players = S.players.filter(p => p.chips > 0);
  S.players.forEach((p, i) => { p.id = i; });          // 重编号，防旧 id 失效
  if (S.players.length < 2) {
    S.phase = 'over';
    logMsg('剩不到 2 人，游戏结束。', 'sys');
    render(); return;
  }
  S.handNo++;
  S.pot = 0; S.street = 0; S.streetBet = 0; S.pots = [];
  S.players.forEach(p => {
    p.folded = false; p.allIn = false; p.street = 0; p.inHand = 0;
    p.acted = false; p.lastAct = '';
  });
  logMsg('━━ 第 ' + S.handNo + ' 手 ━━', 'sys');

  S.phase = 'playing';   // 从摊牌/结算态回到进行中，stepTurn 才会推进
  const n = N();
  S.buttonSeat = S.handNo === 1 ? 0 : (S.buttonSeat + 1) % n;   // 第一手：按钮给 1 号位
  while (S.players[S.buttonSeat].chips <= 0) S.buttonSeat = (S.buttonSeat + 1) % n;

  // 盲注：小盲始终是按钮位左手第一位；大盲在其右侧
  const sbSeat = (S.buttonSeat + 1) % n;
  let utg;
  if (n === 2) {
    postBlind(S.buttonSeat, S.sb, '小盲');                 // 两人桌：按钮位 = 小盲
    postBlind((S.buttonSeat + 1) % n, S.bb, '大盲');
    // 短码大盲可能不足：本轮最高要以实际投入为准
    S.streetBet = Math.max(at((S.buttonSeat + 1) % n).street, at(S.buttonSeat).street);
    utg = S.buttonSeat;
  } else {
    postBlind(sbSeat, S.sb, '小盲');
    if (straddleOn()) {
      // 抓头（live straddle）=额外的 2BB 盲注，真正的大盲顺延到下一位
      postBlind(S.straddleSeat, S.bb * 2, '抓头 2BB');
      postBlind((S.straddleSeat + 1) % n, S.bb, '大盲');
      S.streetBet = S.bb * 2;
      utg = (S.straddleSeat + 2) % n;
    } else {
      postBlind((S.buttonSeat + 2) % n, S.bb, '大盲');
      S.streetBet = S.bb;
      utg = (S.buttonSeat + 3) % n;
    }
  }

  // 翻前 UTG = 大盲左手第一位；两人桌时按钮位（小盲）先动
  S.lastActorSeat = utg - 1;
  S.current = null;
  stepTurn();
}

function postBlind(seat, amount, label) {
  const p = at(seat);
  const pay = Math.min(amount, p.chips);
  p.chips -= pay; p.street += pay; p.inHand += pay;
  if (pay < amount) p.allIn = true;
  logMsg(p.name + ' ' + label + ' ' + fmt(pay) + (pay < amount ? '（不足，全下）' : ''));
}

function collectPot() {
  S.players.forEach(p => { S.pot += p.street; p.street = 0; });
  S.streetBet = 0;
}

/* ---------- 行动流转 ---------- */
const actionable = p => !p.folded && !p.allIn && p.chips > 0;
const needsAction = p => actionable(p) && (!p.acted || p.street < S.streetBet);

function stepTurn() {
  if (S.phase !== 'playing') return;
  const alive = S.players.filter(p => !p.folded);
  if (alive.length <= 1) return toShowdown();
  if (!S.players.some(actionable)) return toShowdown();

  for (let i = 1; i <= N(); i++) {
    const p = at(S.lastActorSeat + i);
    if (needsAction(p)) { S.current = p.id; return render(); }
  }
  if (S.players.filter(actionable).length <= 1) return toShowdown();
  advanceStreet();
}

function advanceStreet() {
  collectPot();
  S.lastActorSeat = -1;
  if (S.players.filter(actionable).length <= 1) return toShowdown();
  S.street++;
  if (S.street > 3) return toShowdown();
  logMsg('━━ ' + STREET_NAME[S.street] + ' ━━', 'sys');
  S.players.forEach(p => { p.street = 0; p.acted = false; });

  // 翻牌后由按钮位左手第一位先动（正常即小盲；抓头时为抓头位）；两人桌为按钮位
  let first = (S.buttonSeat + 1) % N();   // 翻后先动：两人桌=大盲，多人桌=小盲
  let guard = 0;
  while (!actionable(at(first)) && guard++ < N()) first = (first + 1) % N();
  S.lastActorSeat = first - 1;
  stepTurn();
}

/* ---------- 动作 ---------- */
function doFold(p) {
  pushSnap();
  p.folded = true; p.acted = true; p.lastAct = '弃牌';
  logMsg(p.name + ' 弃牌');
  S.lastActorSeat = seatOf(p); S.current = null;
  stepTurn();
}

/** amount = 本轮下注总额 (raise-to)，自动夹在 [已下注, 已下注+后手] */
function doCommit(p, amount) {
  const maxTo = p.street + p.chips;             // 后手封顶
  const minTo = Math.min(Math.max(p.street, S.streetBet), maxTo); // 短码时不会超过后手
  let to = Math.round(Number(amount));
  if (!isFinite(to)) to = minTo;
  to = Math.max(minTo, Math.min(to, maxTo));
  const commit = to - p.street;

  if (commit <= 0) {                       // 已跟平 → 过牌
    pushSnap();
    p.acted = true;
    p.lastAct = '过牌';
    logMsg(p.name + ' 过牌');
    S.lastActorSeat = seatOf(p); S.current = null;
    return stepTurn();
  }

  pushSnap();
  const prevBet = S.streetBet;
  p.chips -= commit; p.street = to; p.inHand += commit;
  p.acted = true;
  const allIn = p.chips === 0;
  if (allIn) p.allIn = true;
  const isRaise = to > prevBet;
  p.lastAct = allIn ? (isRaise ? '全下加注' : '全下跟注') : (isRaise ? '加注' : '跟注');
  if (isRaise) S.streetBet = to;
  const diff = prevBet === 0 ? to : to - prevBet;
  logMsg(p.name + ' ' + p.lastAct + ' ' + fmt(commit) +
    (isRaise ? '　→ 下注到 ' + fmt(to) + ' (+' + fmt(diff) + ')' : ''));
  S.lastActorSeat = seatOf(p); S.current = null;
  stepTurn();
}

/**
 * 未被跟注的下注：投入最多的那个人，超出「第二高」的部分。
 * 正确的实现很简单：最高投入 − 第二高投入 = 没人跟的那部分。
 * 注意：已弃牌的人仍在计入（他的铎牌真的在桌上），所以他们会“匹配”一部分。
 * 例如大盲加注到 500 全桌弃牌：第二高是对家的盲注 10，所以退回 490，底池剩 15。
 */
function uncalledRefund() {
  const list = S.players.filter(p => p.inHand > 0).sort((a, b) => b.inHand - a.inHand);
  if (list.length < 2) return { id: -1, amt: 0 };
  const amt = list[0].inHand - list[1].inHand;
  return amt > 0 ? { id: list[0].id, amt: amt } : { id: -1, amt: 0 };
}

/* ---------- 主池 / 边池 ---------- */
function buildPots() {
  // 1) 退回未被跟注的下注
  const back = uncalledRefund();
  if (back.amt > 0) {
    const p = S.players[back.id];
    p.inHand -= back.amt; p.chips += back.amt; S.pot -= back.amt;
    p.lastAct = '收回 ' + fmt(back.amt);
    logMsg(p.name + ' 收回未被跟注的 ' + fmt(back.amt));
  }

  // 2) 按投入层级切分主池 / 边池
  const levels = S.players.map(p => p.inHand).filter(v => v > 0)
    .filter((v, i, a) => a.indexOf(v) === i).sort((x, y) => x - y);
  const pots = [];
  let prev = 0, carry = 0;
  for (const L of levels) {
    const cnt = S.players.filter(p => p.inHand >= L).length;
    if (cnt === 0) break;
    let amount = (L - prev) * cnt;
    const eligible = S.players.filter(p => p.inHand >= L && !p.folded).map(p => p.id);
    prev = L;
    // 这一层无人可赢（全部弃牌了）→ 并入下一个池
    if (eligible.length === 0) {
      if (pots.length) pots[pots.length - 1].amount += amount;
      else carry += amount;                     // 还没有池：先挂着，给后面第一个池
      continue;
    }
    if (carry > 0) { amount += carry; carry = 0; }  // 把悬着的部分并入当前池
    const last = pots[pots.length - 1];
    const sameSet = last && last.eligible.length === eligible.length &&
      last.eligible.every(id => eligible.indexOf(id) >= 0);
    if (sameSet) last.amount += amount;          // 可赢人一样 → 合并成一个池
    else pots.push({ amount: amount, eligible: eligible, winners: [] });
  }
  if (carry > 0) {
    // 理论不可能（始终有人可赢），保护性建池，避免钱水毁灭
    const alive = S.players.filter(p => !p.folded);
    if (alive.length) pots.push({ amount: carry, eligible: alive.map(p => p.id), winners: [] });
    else S.pot -= carry;
  }
  return pots;
}

function toShowdown() {
  collectPot();
  S.street = 4;
  S.phase = 'showdown';
  S.current = null;
  S.pots = buildPots();
  logMsg('◆ 摊牌 — 底池 ' + fmt(S.pot) +
    (S.pots.length > 1 ? '（' + S.pots.length + ' 个池）' : '') + '，请手动确认', 'sys');
  render();
  openShowdown();
}

function openShowdown() {
  const box = $('showdownPlayers');
  box.innerHTML = '';
  S.pots.forEach((pot, pi) => {
    const only = pot.eligible.length === 1;
    if (only && pot.winners.length === 0) pot.winners = [pot.eligible[0]];

    const card = document.createElement('div');
    card.className = 'potcard';
    const who = only ? S.players[pot.eligible[0]].name : (pot.eligible.length + ' 人可赢');
    card.innerHTML = '<div class="pchead"><span class="pcname">' +
      (pi === 0 ? '主池' : '边池 ' + pi) + '</span><b>' + fmt(pot.amount) +
      '</b><span class="pcdim">' + esc(who) + '</span></div>';

    const row = document.createElement('div');
    row.className = 'sd-players';
    pot.eligible.forEach(id => {
      const p = S.players[id];
      const d = document.createElement('div');
      d.className = 'sd-p' + (pot.winners.indexOf(id) >= 0 ? ' sel' : '');
      d.innerHTML = '<span>' + esc(p.name) + '</span><span class="sd-chip">' + fmt(p.chips) + '</span>';
      d.addEventListener('click', () => {
        const i = pot.winners.indexOf(id);
        if (i >= 0) pot.winners.splice(i, 1); else pot.winners.push(id);
        Array.prototype.forEach.call(row.children, (el, k) =>
          el.classList.toggle('sel', pot.winners.indexOf(pot.eligible[k]) >= 0));
      });
      row.appendChild(d);
    });
    card.appendChild(row);
    box.appendChild(card);
  });

  const folded = S.players.filter(p => p.folded).map(p => p.name);
  $('poolInfo').innerHTML = '合计 <b>' + fmt(S.pot) + '</b> · 每个池选 1 人独赢，选多人则平分' +
    (folded.length ? '<br><span class="dim">已弃牌：' + esc(folded.join('、')) + '</span>' : '');
  $('mShowdown').classList.remove('hidden');
}

function confirmWin() {
  // 清理不合法的选中（例如缺人已离开桌子）
  S.pots.forEach(p => { p.winners = p.winners.filter(id => p.eligible.indexOf(id) >= 0); });
  let miss = S.pots.findIndex(p => p.winners.length === 0);
  if (miss < 0 && !S.pots.length) return toast('底池为 0，直接开新一手');
  if (miss >= 0) return toast('请先为' + (miss === 0 ? '主池' : '边池 ' + miss) + '选择赢家');
  S.pots.forEach(pot => {
    const winners = pot.winners.map(id => S.players[id]);
    const share = Math.floor(pot.amount / winners.length);
    let rem = pot.amount - share * winners.length;
    winners.forEach(w => {
      let amt = share;
      if (rem > 0) { amt += rem; rem = 0; }
      w.chips += amt;
      w.lastAct = (winners.length > 1 ? '平分 +' : '赢下 +') + fmt(amt);
      logMsg('★ ' + w.name + (winners.length > 1 ? ' 平分 ' : ' 赢下 ') + fmt(amt) +
        ' → 筹码 ' + fmt(w.chips), 'sys');
    });
  });
  S.pot = 0; S.pots = [];
  $('mShowdown').classList.add('hidden');
  render();
  toast('已结算');
}

/* ---------- 渲染 ---------- */
function render() { renderStats(); renderSeats(); renderFooter(); }

function renderStats() {
  $('stPot').textContent = fmt(boardPot());
  $('stBet').textContent = fmt(S.streetBet);
  $('stBlinds').textContent = S.sb + '/' + S.bb;
  $('stHand').textContent = S.handNo || '—';
  $('stStreet').textContent = S.phase === 'showdown' ? '摊牌'
    : (S.phase === 'over' ? '结束' : (STREET_NAME[S.street] || '—'));
  $('potBig').textContent = fmt(boardPot());
  const bits = [];
  if (S.streetBet > 0) bits.push('本轮最高 ' + fmt(S.streetBet));
  bits.push('未弃牌 ' + S.players.filter(p => !p.folded).length + ' 人');
  $('betLine').textContent = bits.join(' · ');
}

function renderSeats() {
  const wrap = $('seats');
  wrap.innerHTML = '';
  if (!S.players.length) {
    wrap.innerHTML = '<div class="empty">点下方「开始游戏」设置牌桌</div>';
    return;
  }
  const n = N();
  const sbSeat = (S.buttonSeat + 1) % n;
  const bbSeat = (S.buttonSeat + 2) % n;
  const strOn = straddleOn();
  S.players.forEach((p, i) => {
    const isTurn = S.current === p.id && S.phase === 'playing';
    const seat = document.createElement('div');
    seat.className = ['seat', isTurn ? 'active' : '', p.folded ? 'folded' : '',
      /赢下|平分/.test(p.lastAct) ? 'winner' : ''].join(' ');
    let pos = String(i + 1);
    if (S.phase !== 'over') {
      if (i === S.buttonSeat) pos = 'BTN';
      else if (i === sbSeat) pos = 'SB';
      else if (strOn && i === S.straddleSeat) pos = 'BB*';
      else if (i === bbSeat) pos = 'BB';
    }
    seat.innerHTML =
      '<div class="top"><span class="badge">' + pos + '</span>' +
      '<span class="pname">' + esc(p.name) + '</span>' +
      (p.allIn ? '<span class="tag">ALL IN</span>' : '') + '</div>' +
      '<div class="money">' + fmt(p.chips) + '<small> 筹码</small></div>' +
      '<div class="status ' + statusCls(p) + '">' + esc(p.lastAct || '等待') + '</div>' +
      '<div class="act"></div>';
    if (isTurn) renderSeatActions(seat.querySelector('.act'), p);
    wrap.appendChild(seat);
  });
}
function statusCls(p) {
  const a = p.lastAct || '';
  if (/弃牌|全下/.test(a)) return 'f';
  if (/赢下|平分/.test(a)) return 'w';
  if (/过牌|跟注|加注/.test(a)) return 'a';
  return '';
}

/* ---------- 座位内下注 UI ---------- */
function renderSeatActions(box, p) {
  const toCall = Math.max(0, S.streetBet - p.street);
  const minTo = Math.max(p.street, S.streetBet);
  const maxTo = p.street + p.chips;
  const potNow = boardPot();

  const pct = v => Math.max(0, Math.min(100, Math.round((v - p.street) / p.chips * 100)));
  const b = (label, val, cls) =>
    '<button class="qbtn ' + (cls || '') + '" data-v="' + val + '">' + label + '</button>';

  let html = '<div class="quick">';
  html += toCall > 0 ? b('跟注 ' + fmt(toCall), minTo, 'call') : b('过牌', 0, 'call');
  [['1/3池', 1 / 3], ['1/2池', 1 / 2], ['3/4池', 3 / 4], ['满池', 1]].forEach(pair => {
    const v = Math.min(maxTo, Math.round(toCall + potNow * pair[1]));
    if (v > minTo) html += b(pair[0], v);
  });
  if (maxTo > minTo) html += b('ALL IN', maxTo);
  html += '</div>';

  html += '<div class="betrow"><div class="sliderwrap">' +
    '<input type="range" min="0" max="100" value="' + pct(minTo) + '">' +
    '<div class="sliderfoot"><span>0</span><span class="mid">跟注 ' + fmt(toCall) +
    '</span><span>' + fmt(maxTo) + '</span></div></div>' +
    '<div class="amin"><input type="number" class="betnum" value="' + minTo + '"></div></div>' +
    '<div class="actions">' +
    '<button class="btn fold" data-a="fold">弃牌</button>' +
    '<button class="btn ok" data-a="ok">' + (toCall > 0 ? '跟注 ' + fmt(toCall) : '过牌') + '</button>' +
    '</div>';
  box.innerHTML = html;

  const rng = box.querySelector('input[type=range]');
  const num = box.querySelector('.betnum');
  const ok = box.querySelector('[data-a=ok]');
  const clamp = v => Math.max(minTo, Math.min(Math.round(Number(v)) || 0, maxTo));
  const sync = () => {
    const to = clamp(num.value);
    num.value = to;
    rng.value = pct(to);
    ok.textContent = to <= toCall ? (toCall > 0 ? '跟注 ' + fmt(toCall) : '过牌') : '确定 ' + fmt(to);
  };
  rng.addEventListener('input', () => {
    num.value = clamp(p.street + Number(rng.value) / 100 * p.chips);
    sync();
  });
  num.addEventListener('input', sync);
  num.addEventListener('blur', sync);

  Array.prototype.forEach.call(box.querySelectorAll('[data-v]'), x =>
    x.addEventListener('click', () => doCommit(p, Number(x.dataset.v))));
  box.querySelector('[data-a=fold]').addEventListener('click', () => doFold(p));
  ok.addEventListener('click', () => doCommit(p, num.value));
}

/* ---------- 底部栏 ---------- */
function renderFooter() {
  const turn = $('abTurn'), hint = $('abHint');
  const showNext = S.phase === 'showdown' && $('mShowdown').classList.contains('hidden');
  $('btnStart').classList.toggle('hidden', S.phase !== 'idle');
  $('btnNext').classList.toggle('hidden', !showNext);
  const cur = S.current !== null ? S.players[S.current] : null;
  if (S.phase === 'playing' && cur) {
    const toCall = Math.max(0, S.streetBet - cur.street);
    turn.textContent = '轮到 ' + cur.name;
    hint.textContent = toCall > 0 ? '需跟注 ' + fmt(toCall) : '无需跟注 · 可过牌或下注';
  } else if (S.phase === 'showdown') {
    turn.textContent = '摊牌中 — 请确认赢家';
    hint.textContent = '选 1 人独赢 · 选多人平分';
  } else if (S.phase === 'over') {
    turn.textContent = '游戏结束';
    hint.textContent = '点「牌桌设置」重开';
  } else {
    turn.textContent = '等待开局';
    hint.textContent = '只记录筹码 · 现实发牌';
  }
}

/* ---------- 设置 ---------- */
function openSetup() {
  $('setPlayers').value = S.players.length || 6;
  $('setBuyin').value = S.players.length ? Math.max.apply(null, S.players.map(p => p.chips)) : 1000;
  $('setSb').value = S.sb;
  $('setBb').value = S.bb;
  buildNames(S.players.length || 6, S.players.map(p => p.name), S.straddleSeat);
  $('mSetup').classList.remove('hidden');
}
function buildNames(count, old, straddle) {
  const nl = $('nameList');
  nl.innerHTML = '';
  old = old || [];
  const sel = $('setStraddle');
  sel.value = straddle >= 0 ? String(straddle) : '';
  const paint = () => Array.prototype.forEach.call(nl.querySelectorAll('.nrow'), (r, i) =>
    r.classList.toggle('str', sel.value !== '' && Number(sel.value) === i));
  for (let i = 0; i < count; i++) {
    const w = document.createElement('div');
    w.className = 'nrow';
    w.innerHTML = '<input type="text" value="' + esc(old[i] || '') + '" placeholder="玩家 ' + (i + 1) + '">' +
      '<button class="stbtn" type="button">抓头</button>';
    w.querySelector('.stbtn').addEventListener('click', () => {
      sel.value = sel.value === String(i) ? '' : String(i);
      paint();
    });
    nl.appendChild(w);
  }
  paint();
}

/* ---------- 事件 ---------- */
$('btnSetup').addEventListener('click', openSetup);
$('btnCancelSetup').addEventListener('click', () => $('mSetup').classList.add('hidden'));
$('setPlayers').addEventListener('input', () => {
  const c = Math.max(2, Math.min(10, Number($('setPlayers').value) || 6));
  const cur = Array.prototype.map.call($('nameList').querySelectorAll('input'), x => x.value);
  buildNames(c, cur, $('setStraddle').value === '' ? -1 : Number($('setStraddle').value));
});
$('btnSaveSetup').addEventListener('click', () => {
  const count = Math.max(2, Math.min(10, Number($('setPlayers').value) || 6));
  const buyin = Math.max(1, Number($('setBuyin').value) || 1000);
  const sb = Math.max(1, Number($('setSb').value) || 5);
  const bb = Math.max(sb, Number($('setBb').value) || 10);
  const names = Array.prototype.map.call($('nameList').querySelectorAll('input'), x => x.value);
  const sv = $('setStraddle').value;
  const st = sv === '' ? -1 : Math.max(0, Math.min(count - 1, Number(sv)));
  $('mSetup').classList.add('hidden');
  newGame({ count: count, buyin: buyin, sb: sb, bb: bb, names: names, straddleSeat: st });
  toast('牌桌已重开');
});
$('btnStart').addEventListener('click', openSetup);
$('btnNext').addEventListener('click', () => { $('mShowdown').classList.add('hidden'); nextHand(); });
$('btnUndo').addEventListener('click', undo);
$('btnConfirmWin').addEventListener('click', confirmWin);
$('btnSplit').addEventListener('click', confirmWin);
document.addEventListener('keydown', e => {
  if (e.target && e.target.tagName === 'INPUT') return;
  if ($('mShowdown').classList.contains('hidden')) return;
  let pi = S.pots.findIndex(p => p.eligible.length > 1);
  if (pi < 0) pi = 0;
  const pot = S.pots[pi];
  if (!pot) return;
  const idx = Number(e.key) - 1;
  if (!(idx >= 0 && idx < pot.eligible.length)) return;
  const id = pot.eligible[idx];
  const i = pot.winners.indexOf(id);
  if (i >= 0) pot.winners.splice(i, 1); else pot.winners.push(id);
  openShowdown();
});

render();


